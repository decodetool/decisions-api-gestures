{
  "name": "openai-decisions-stroke-recognition",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs --production",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build:private": "npm run check && NODE_ENV=development vite build --mode development"
  },
  "dependencies": {
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tldraw": "5.4.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
